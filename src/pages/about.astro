---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Main pageTitle={about.data.title} hideHeading class="app-prose pt-8">
    <div id="about-content" data-start={about.data.siteStartedAt.toISOString()}>
      <Content />
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  let timer: ReturnType<typeof setInterval> | undefined;
  function startUptime() {
    clearInterval(timer);
    const root = document.querySelector<HTMLElement>("#about-content");
    if (!root) return;
    const start = Date.parse(root.dataset.start!);
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      if (
        node.textContent?.includes("{{uptime}}") &&
        !node.parentElement?.closest("pre, code, script, style")
      )
        nodes.push(node);
    }
    for (const node of nodes) {
      const fragment = document.createDocumentFragment();
      const parts = node.textContent!.split("{{uptime}}");
      parts.forEach((part, index) => {
        if (index) {
          const span = document.createElement("span");
          span.dataset.uptime = "";
          span.style.fontVariantNumeric = "tabular-nums";
          fragment.append(span);
        }
        fragment.append(document.createTextNode(part));
      });
      node.replaceWith(fragment);
    }
    const counters = root.querySelectorAll<HTMLElement>("[data-uptime]");
    if (!counters.length) return;
    const update = () => {
      counters.forEach(
        counter =>
          (counter.textContent = String(
            Math.max(0, Math.floor((Date.now() - start) / 1000))
          ))
      );
    };
    update();
    timer = setInterval(update, 1000);
  }
  document.addEventListener("astro:page-load", startUptime);
  document.addEventListener("astro:before-swap", () => clearInterval(timer));
</script>
