---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Main pageTitle={about.data.title} hideHeading class="app-prose pt-8">
    <Content />
    <p>
      本站已运行 <span
        id="site-uptime"
        data-start={about.data.siteStartedAt.toISOString()}
        style="font-variant-numeric: tabular-nums">0</span
      > 秒
    </p>
  </Main>

  <Footer />
</Layout>

<script>
  let timer: ReturnType<typeof setInterval> | undefined;
  function startUptime() {
    clearInterval(timer);
    const counter = document.querySelector<HTMLElement>("#site-uptime");
    if (!counter) return;
    const start = Date.parse(counter.dataset.start!);
    const update = () => {
      counter.textContent = String(
        Math.max(0, Math.floor((Date.now() - start) / 1000))
      );
    };
    update();
    timer = setInterval(update, 1000);
  }
  document.addEventListener("astro:page-load", startUptime);
  document.addEventListener("astro:before-swap", () => clearInterval(timer));
</script>
