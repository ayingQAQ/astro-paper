---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<button
  type="button"
  data-button="back-to-top"
  class="focus-outline hover:text-accent inline-flex min-h-11 shrink-0 cursor-pointer items-center gap-1 px-2 py-2 text-sm transition-colors"
>
  <IconArrowNarrowUp class="size-4" aria-hidden="true" />
  <span>{t.post.backToTop}</span>
</button>

<script is:inline data-astro-rerun>
  document
    .querySelector("[data-button='back-to-top']")
    ?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "instant" });
    });
</script>
