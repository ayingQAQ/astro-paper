---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border border-t py-6 sm:py-4">
    <p class="footer-credit my-2 text-center text-base sm:text-start">
      <span>Copyright &#169; {currentYear}</span>
      <span aria-hidden="true"> | </span>
      <span>
        {"Powered by "}<a
          href="https://github.com/withastro/astro"
          class="hover:text-accent no-underline">Astro</a
        >
        {" and "}<a
          href="https://github.com/satnaing/astro-paper"
          class="hover:text-accent no-underline">AstroPaper</a
        >
      </span>
    </p>
  </div>
</footer>

<style>
  @font-face {
    font-family: "STIX Italic";
    src: url("../assets/fonts/STIX-Italic-VF.woff2") format("woff2");
    font-style: italic;
    font-weight: 400 700;
    font-display: swap;
  }

  .footer-credit {
    font-family: "STIX Italic", Georgia, serif;
    font-style: italic;
  }
</style>
